# LIA Backend — Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Use a long cryptographically random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── AI / LLM Configuration ──────────────────────────────────────────────────
# Google Gemini API Key (optional — falls back gracefully if not set)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
AI_PROVIDER=gemini

# ─── Admin Seed (used ONLY by scripts/seedAdmin.js) ──────────────────────────
# Run: node scripts/seedAdmin.js
# Do NOT start the server with this — it's a one-time setup script
ADMIN_NAME=LIA Administrator
ADMIN_EMAIL=admin@vlits.edu.in
ADMIN_PASSWORD=change_this_strong_password

# ─── RAG & Vector Database Configuration ──────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_COLLECTION=lia_knowledge
CHROMA_PATH=./chroma_data

# ─── Hybrid Search & RRF Configuration ────────────────────────────────────────
RRF_K=60
RAG_VECTOR_TOP_K=10
RAG_BM25_TOP_K=10
RAG_FINAL_TOP_K=5

# ─── Cross-Encoder Reranker Configuration ─────────────────────────────────────
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_HYBRID_TOP_K=10
RAG_RERANK_TOP_K=5

# ─── Grounded RAG & Generation Configuration ──────────────────────────────────
RAG_MAX_CONTEXT_CHARS=20000
RAG_MIN_RERANK_SCORE=-8.0

# ─── OCR Configuration ────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=50

